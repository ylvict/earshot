{
  "name": "earshot",
  "version": "0.1.0",
  "private": true,
  "description": "Hear it. Read it. Local-first streaming speech-to-text for Node, browsers (WASM) and as a service.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "src/core",
    "src/engine-node",
    "src/engine-wasm",
    "src/sdk",
    "src/server"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "download:models": "node models/scripts/download.mjs",
    "start:server": "node src/server/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=23.6"
  }
}
