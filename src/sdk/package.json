{
  "name": "@earshot/sdk",
  "version": "0.1.0",
  "description": "Hear it, read it. One-line local speech-to-text for Node.js and browsers (WASM).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "import": "./dist/wasm.mjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earshot/core": "*",
    "sherpa-onnx-node": "^1.13.8"
  },
  "engines": {
    "node": ">=18"
  }
}