{
  "name": "@earshot/sdk",
  "version": "0.1.0",
  "description": "Hear it, read it. One-line local speech-to-text for Node.js and browsers (WASM).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@earshot/core": "^0.1.0",
    "sherpa-onnx-node": "^1.13.8"
  },
  "engines": {
    "node": ">=18"
  }
}