{
  "name": "@earshot/server",
  "version": "0.1.0",
  "description": "Earshot as a service: REST transcription plus streaming WebSocket endpoint.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "asr-server": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earshot/core": "*",
    "sherpa-onnx-node": "^1.13.8",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  }
}